{
  "name": "ngeshare-analytics",
  "version": "1.0.0",
  "description": "Analytics dashboard and sync for ngeShare",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync": "node src/index.js",
    "sync:debug": "DEBUG=true node src/index.js",
    "publish": "node publish/index.js",
    "publish:debug": "DEBUG=true node publish/index.js",
    "mirror": "node publish/mirror-to-neon.js",
    "refresh-neon": "pnpm run publish && pnpm run mirror",
    "refresh-analytics": "pnpm sync && pnpm run publish",
    "refresh-analytics:debug": "DEBUG=true pnpm sync && DEBUG=true pnpm run publish",
    "dev": "node --watch src/web/server.js",
    "start": "node src/web/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
